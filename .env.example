BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321
# Optional: custom yt-dlp binary path (default: yt-dlp)
YT_DLP_PATH=yt-dlp
# Optional: path to ffmpeg.exe directory (default: current directory)
# FFMPEG_PATH=./ffmpeg.exe
# Optional: max file size in MB Telegram can send (default 2000, bot will try to compress/select lower quality if exceeded)
MAX_FILE_SIZE_MB=50
# Optional: download directory
DOWNLOAD_DIR=./downloads
# Optional: database path
DATABASE_PATH=./data/bot.db
# YouTube cookies (OPTIONAL now — only needed for age-gated/private/
# members-only videos or when the server IP is rate-limited). The bot tries
# anonymous clients (android/mweb/web_safari/web_embedded, no login) FIRST, so most public
# videos download with nothing uploaded. When cookies ARE needed, pick one:
# 1) Path to a Netscape-format cookies file exported from a logged-in browser
#    (recommended for servers). Export with the "Get cookies.txt LOCALLY"
#    browser extension while logged in at youtube.com, save it as cookies.txt
#    next to the bot. IMPORTANT: never commit cookies.txt to git.
COOKIES_PATH=./cookies.txt
# 1b) YOUTUBE_COOKIE_MODE: auto (default) = anonymous first, cookies fallback.
#    "cookies" = cookies first (old behavior). "never" = never use cookies.
# YOUTUBE_COOKIE_MODE=auto
# 1b) COOKIES_CONTENT: same file, but pasted into an env var (raw text or
#    base64). REQUIRED on Render free plan — its filesystem is ephemeral and
#    an uploaded cookies.txt is wiped on every restart/redeploy. When set,
#    the bot rewrites COOKIES_PATH from this value on every boot.
#    Fastest refresh flow (no restart, no dashboard): send the fresh
#    cookies.txt to the bot in Telegram as an admin — it applies instantly —
#    then also paste it here so it survives restarts.
# COOKIES_CONTENT=
# 2) OR let yt-dlp read cookies directly from a local browser
#    (only works when a browser with a logged-in YouTube session exists on
#    the same machine, e.g. your own PC — not on most servers):
# COOKIES_FROM_BROWSER=chrome
# Optional: YouTube quality cap (default 720). 720p is 3-5x smaller than
# 1080p+, so downloads + Telegram uploads are much faster and still fit the
# 50MB bot limit. Set 1080 or 0 (uncapped) for full quality.
# YOUTUBE_MAX_HEIGHT=720
# Optional: proxy for yt-dlp (when the datacenter IP itself is hard-blocked by
# YouTube, a residential proxy is the only fix). HTTP(S)/SOCKS5 accepted:
# YT_DLP_PROXY=http://user:pass@host:port
# --- Alternative (non-yt-dlp) download methods -----------------------------
# Invidious (YouTube fast path, ON by default, no setup needed): resolves the
# MP4 through a public Invidious instance and downloads it with plain HTTPS —
# no yt-dlp bot-checks, no cookies, no ffmpeg merge (much faster). yt-dlp is
# still the automatic fallback. Set to false to force yt-dlp-only.
# INVIDIOUS_ENABLED=true
# Optional: override the instance list (failover in order, comma-separated).
# INVIDIOUS_INSTANCES=https://yewtu.be,https://inv.nadeko.net,https://invidious.nerdvpn.de
# Optional: Cobalt API (all platforms, needs YOUR self-hosted instance —
# public cobalt.tools is blocked for YouTube since 2025). Deploy one via
# Docker (ghcr.io/imputnet/cobalt) or Railway, then set its URL here:
# COBALT_API_URL=https://your-app.up.railway.app
# Optional: API key when your Cobalt instance requires auth.
# COBALT_API_KEY=
# Optional: TikTok fallback API (default true). When yt-dlp is blocked by
# TikTok (IP blocks / API changes), the bot resolves the mp4 via a fallback
# service. Set to false to disable.
TIKTOK_FALLBACK=true
# Optional: keep-alive on Render free plan (defaults work, no setup needed).
# The bot answers GET /, /health, /ping with 200 and pings its own /health
# every 10 min to reset Render's ~15 min idle spin-down timer while awake.
# Self-ping can't wake a sleeping instance, so for best results also add a
# free external pinger (UptimeRobot / cron-job.org every 5 min):
#   https://<your-app>.onrender.com/health
# KEEPALIVE_URL=https://<your-app>.onrender.com
# KEEPALIVE_INTERVAL_MINUTES=10
# KEEPALIVE_ENABLED=true
